{
  "name": "stylelint-config-upleveled",
  "version": "2.0.5",
  "description": "UpLeveled Stylelint defaults for styling in CSS, SCSS, Sass, CSS Modules and CSS-in-JS",
  "keywords": [
    "config",
    "css",
    "sass",
    "scss",
    "stylelint-config",
    "stylelint"
  ],
  "repository": "upleveled/stylelint-config-upleveled",
  "license": "MIT",
  "author": "UpLeveled",
  "contributors": [
    "Jose Höwer <josehower@gmail.com>",
    "Karl Horky <karl.horky@gmail.com>"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "./index.js"
  ],
  "scripts": {
    "test": "CI=true vitest"
  },
  "dependencies": {
    "postcss-styled-syntax": "0.7.2",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-recommended-scss": "17.0.1"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "eslint": "10.10.0",
    "eslint-config-upleveled": "10.0.4",
    "execa": "9.6.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "stylelint": "^17.15.0",
    "stylelint-scss": "^7.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.26.0",
      "onFail": "download"
